# iDors environment configuration
# Copy these variables into Render > Environment.

# Render PostgreSQL
# Use the Internal Database URL from your Render PostgreSQL service.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Session security
# Replace this with a long random secret in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Server
PORT=8787
HOST=0.0.0.0
